# The iroh-gateway edge as a hardened systemd service. Install it, as root, from the
# directory the release tarball was unpacked into:
#
#   install -m 0755 iroh-gateway-edge /usr/local/bin/iroh-gateway-edge
#   install -m 0644 iroh-gateway-edge.service /etc/systemd/system/iroh-gateway-edge.service
#   systemctl daemon-reload
#
# The edge's id (its EndpointId), for spec.endpointId of the Edge object; this creates the
# key in the service's own state directory (/var/lib/iroh-gateway-edge) if it is missing:
#
#   systemd-run --wait --pipe --collect -p DynamicUser=yes -p StateDirectory=iroh-gateway-edge /usr/local/bin/iroh-gateway-edge id
#
# Then write the operator's EndpointId into /etc/iroh-gateway-edge/env as
# IROH_GATEWAY_EDGE_OPERATOR=<64 hex characters>, with any other IROH_GATEWAY_EDGE_* setting,
# and start it with: systemctl enable --now iroh-gateway-edge

[Unit]
Description=iroh-gateway edge
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/iroh-gateway-edge run
EnvironmentFile=/etc/iroh-gateway-edge/env
DynamicUser=yes
StateDirectory=iroh-gateway-edge
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitNOFILE=65536
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
